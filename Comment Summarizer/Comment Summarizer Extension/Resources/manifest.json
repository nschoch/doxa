{
  "manifest_version": 3,
  "name": "Doxa",
  "version": "1.1.1",
  "description": "Summarize Reddit and YouTube comments in one click. Local Ollama or your own API key.",
  "homepage_url": "https://github.com/nschoch/doxa",
  "developer": {
    "name": "Nick Schoch",
    "url": "https://github.com/nschoch"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "comment-summarizer@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.reddit.com/*",
    "*://*.youtube.com/*",
    "http://*/*",
    "https://openrouter.ai/*",
    "https://www.googleapis.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Doxa"
  },
  "commands": {
    "summarize": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Alt+S"
      },
      "description": "Summarize comments on this page"
    },
    "summarize-with-gemini": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Command+Alt+G"
      },
      "description": "Summarize this YouTube video with Gemini"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
